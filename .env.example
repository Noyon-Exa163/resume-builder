# Temporary interim safeguard (Phase 6): gates /settings and /api/settings/*
# only, until real Google OAuth (@exabyting.com) replaces it.
ADMIN_SETTINGS_PASSWORD=

# Used to sign the passphrase-gate session cookie AND the real user session
# cookie. Generate a random string.
SESSION_SECRET=

# Netlify Blobs (admin settings storage) works automatically when deployed on
# Netlify. For local `netlify dev`, no extra config is needed; the Netlify CLI
# provisions a local blobs store automatically.

# Neon Postgres connection string. Users + resumes live here — see
# db/migrations/0001_init.sql for schema. Get this from the Neon console
# (or `get_connection_string` via the Neon MCP tools) for your project.
DATABASE_URL=

# One-time bootstrap values for `npm run seed:admin` (scripts/seedAdmin.ts).
# The app does not read these at runtime — they only create the first admin
# user so someone can log in and provision other accounts (no self-serve signup).
ADMIN_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
