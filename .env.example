# Temporary interim safeguard (Phase 6): gates /settings and /api/settings/*
# only, until real Google OAuth (@exabyting.com) replaces it.
ADMIN_SETTINGS_PASSWORD=

# Used to sign the passphrase-gate session cookie. Generate a random string.
SESSION_SECRET=

# Netlify Blobs (admin settings storage) works automatically when deployed on
# Netlify. For local `netlify dev`, no extra config is needed; the Netlify CLI
# provisions a local blobs store automatically.
